<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <AssemblyName>BreakReminderApp</AssemblyName>
    <RootNamespace>BreakReminderApp</RootNamespace>
    <Version>1.0.0</Version>
    <Authors>Break Reminder Team</Authors>
    <Description>A minimal, resource-efficient Windows desktop application for screen break and hydration reminders</Description>
    <Copyright>Copyright 2024</Copyright>
    <StartupObject>BreakReminderApp.App</StartupObject>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

</Project>
